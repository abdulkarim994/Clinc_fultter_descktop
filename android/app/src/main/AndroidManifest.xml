<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- إلزامي لوضع السحابة (مزامنة Supabase ورفع R2) في نسخة release -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- م87 — الدخول بالبصمة (بديل أسرع للرمز) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- م39 — رفع صور الأشعة من المعرض/الملفات:
         أندرويد 13+ يقرأ الصور بإذن READ_MEDIA_IMAGES؛ والأقدم (حتى
         API 32) بإذن READ_EXTERNAL_STORAGE. منتقي المستندات (SAF) لا
         يحتاج إذناً — الإذنان يغطيان منتقي المعرض على كل الأجهزة. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- م172 — التصوير المباشر للأشعة بكاميرا داخل التطبيق (شاشة كاميرا
         خاصة بهوية التطبيق — لا تطبيق الكاميرا الأساسي). الإذن وقت
         التشغيل تطلبه إضافة camera عند التهيئة، والرفض يُعالج برسالة. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- م68/دفعة ثانٍ-أ — تقوية الخصوصية:

         allowBackup: كانت الخاصية **غائبة**، وغيابها يعني true. فمجلد
         files بكامله — قاعدة المرضى غير المشفّرة، وsession.json برمز تحديث
         دائم، وصور الأشعة وملفات PDF — كان يُرفع إلى Google Drive تلقائياً
         ويُستخرج بـ adb backup. واستعادة session.json على جهاز آخر تمنح
         رمزاً عاملاً بلا ربط بالجهاز: استيلاء كامل على الحساب من ملف نسخة
         احتياطية. التعطيل هو الوضع الصحيح لبيانات صحية.

         dataExtractionRules/fullBackupContent: مضبوطان أيضاً دفاعاً بالعمق
         لو أُعيد تفعيل النسخ لاحقاً — يستثنيان القاعدة والجلسة والأسرار.

         usesCleartextTraffic: كان يعتمد على الافتراض الضمني لـ targetSdk؛
         التصريح به يجعله قراراً ثابتاً لا أثراً جانبياً لإعداد آخر. -->
    <application
        android:label="طب الأسنان الرقمي"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher">
        <!-- م88 — singleTask بدل singleTop: عودة OAuth من المتصفح الخارجي
             (dentaldk://login-callback) يجب أن تصل إلى **النسخة القائمة**
             من النشاط. مع singleTop قد يُنشئ النظام نسخةً ثانية داخل مهمة
             المتصفح — أي محرّك Flutter ثانٍ يفتح قاعدة العيادة المشفَّرة
             وقفلَ الإقلاع البارد مرة أخرى بالتوازي. singleTask هو النمط
             الموثَّق لتطبيقات Flutter المستقبِلة للروابط العميقة. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- م88 — عودة دخول Google: مطابقٌ حرفياً لـ uri_allow_list على
                 الخادم ولثابت kAndroidRedirect في الشيفرة. autoVerify لا
                 يلزم لمخطط مخصص (ليس http). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="dentaldk" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
