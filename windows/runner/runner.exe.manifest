<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- إدراك DPI لكل شاشة (v2): الحدّ الأدنى وتحجيم النافذة يعملان
           صحيحاً عبر شاشات مختلفة الكثافة. النمط V2 هو ما يعتمده معالج
           WM_GETMINMAXINFO في win32_window.cpp. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- احتياط للأنظمة الأقدم التي لا تقرأ dpiAwareness أعلاه: تبقى
           النافذة مدركةً لـ DPI بنمط PerMonitor بدل أن يُشوّهها النظام. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <!-- صفحة الترميز النشطة UTF-8: واجهات Win32 ذات النمط A (مثل مسارات
           %LOCALAPPDATA% وأسماء ملفات المرضى العربية) تُقرأ وتُكتب UTF-8
           بلا تلف محارف. حرجٌ في تطبيق عربي بالكامل. مدعومة على
           Windows 10 1903+ ويُتجاهَل بأمان على ما دونها. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <!-- إدراك المسارات الطويلة: مجلدات AppData المتداخلة (خزنة الأشعة،
           التصديرات) قد تتجاوز حدّ MAX_PATH التقليدي. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 — يشترك النظامان في هذا المعرّف -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
