# ============================================================================
#  إعداد البناء السحابي — انسخ هذا الملف إلى tool/cloud.env واملأه بقيمك
#      cp tool/cloud.env.example tool/cloud.env
#
#  ⚠ tool/cloud.env مستثنى من git عمداً — لا تُضِفه ولا تشاركه.
#
#  م68/دفعة ثانٍ-أ: كانت هذه القيم مكتوبةً نصاً صريحاً داخل سكربتَي البناء
#  وغيرَ مستثناة من git، فكانت تسافر مع كل نسخة من الأرشيف.
# ============================================================================

# رابط مشروع Supabase — Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# المفتاح العلني anon — Settings → API → anon public
#   لا تضع service_role هنا أبداً.
SUPABASE_ANON_KEY=

# رابط عامل Cloudflare لصور الأشعة (اختياري — بدونه تبقى الصور محلية)
R2_WORKER=

# أعلام بناء يجب أن تطابق الخلفية التي كُتبت بها البيانات
#   PHONE_IDENTITY: مفاتيح هوية المرضى p:هاتف:اسم
#   COLD_FETCH    : تعزيز البحث من الخادم
PHONE_IDENTITY=1
COLD_FETCH=1

# م88/ج — معرّف عميل الويب من Google Cloud (OAuth client من نوع Web).
# عامٌّ بطبعه (يُشحن داخل التطبيق) لكن يبقى هنا خارج git مع بقية الإعداد.
# وجوده يفعّل نافذة حسابات Google الأصلية داخل التطبيق على أندرويد.
GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
